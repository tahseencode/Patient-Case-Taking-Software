import hmac
import os
from typing import Optional

from fastapi import Header, HTTPException, status


def _is_dev() -> bool:
    return os.getenv("APP_ENV", "production").lower() == "development"


def verify_key(candidate: Optional[str]) -> bool:
    expected = os.getenv("STAFF_API_KEY", "")
    if not expected:
        return _is_dev()          # no key configured -> deny (except local dev)
    if not candidate:
        return False
    return hmac.compare_digest(candidate.encode(), expected.encode())


async def require_staff(x_api_key: Optional[str] = Header(default=None)) -> None:
    if not verify_key(x_api_key):
        raise HTTPException(
            status_code=status.HTTP_401_UNAUTHORIZED,
            detail="Staff authentication required",
            headers={"WWW-Authenticate": "ApiKey"},
        )